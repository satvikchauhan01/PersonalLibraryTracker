MONGO_URI=
JWT_SECRET=
GEMINI_API_KEY=
CLIENT_URL=http://localhost:3000
NODE_ENV=development
PORT=5001

# Phase 09: Razorpay (test-mode keys from your Razorpay Dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# Phase 10: Cloudinary (Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 12: Resend (API Keys → create key). RESEND_FROM_EMAIL must be on a
# domain you've verified in Resend — until then, the sandbox default below
# only delivers to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Library Nest <onboarding@resend.dev>
